; This file is for unifying the coding style for different editors and IDEs.
; EditorConfig is natively supported by PhpStorm, VS Code, and most modern IDEs
; More information at http://editorconfig.org

root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP (PSR-12)
[*.php]
indent_style = space
indent_size = 4

# JavaScript / TypeScript / React
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2

# Styles
[*.{css,scss,sass,less}]
indent_style = space
indent_size = 2

# HTML
[*.{html,htm}]
indent_style = space
indent_size = 4

# YAML (Symfony config, GitHub Actions...)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown — don't trim trailing whitespace (two trailing spaces = intentional line break)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Composer — 4 spaces (PHP convention), npm stays on *.json (2 spaces)
[composer.json]
indent_size = 4

# Makefile — requires real tabs
[Makefile]
indent_style = tab
